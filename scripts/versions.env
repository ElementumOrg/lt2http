# Dependency versions used by scripts/install_dependencies.sh (and the docker images built with it)

# https://cmake.org/ (3.x: CMake 4 refuses projects with cmake_minimum_required < 3.5, like oatpp)
CMAKE_VERSION=3.31.12
CMAKE_SHA256=0dc2e9a6860f06bf10bd8fadc03e35d9eeb4df46e33763a7e480e987758f385c

# https://github.com/ianlancetaylor/libbacktrace
BACKTRACE_VERSION=0b9b49cf4a2c9229fc052d6716e1528b2f23e91a

# https://www.boost.org/ (libtorrent 1.2 needs the asio API removed in Boost 1.87)
BOOST_VERSION=1.86.0
BOOST_SHA256=1bed88e40401b2cb7a1f76d4bab499e352fa4d0c5f31c0dbae64e24d34d7513b

# https://www.openssl.org/
OPENSSL_VERSION=1.1.1w
OPENSSL_SHA256=cf3098950cb4d853ad95c0841f1f9c6d3dc102dccfcacd521d93925208b76ac8

# https://github.com/oatpp/oatpp
OATPP_VERSION=1.3.1

# https://github.com/oatpp/oatpp-swagger
OATPP_SWAGGER_VERSION=1.3.1

# https://github.com/arvidn/libtorrent (lt2http uses the 1.2 storage interface)
LIBTORRENT_VERSION=v1.2.20
