{
  "name": "lt2http-web",
  "private": true,
  "description": "Web UI of lt2http, built into web/dist and from there into the lt2http binary",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@mantine/notifications": "9.7.5",
    "@tabler/icons-react": "3.50.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
